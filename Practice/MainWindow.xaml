<Window x:Class="Practice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Practice"
        Title="Магазин — Каса" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>

        <local:StockBrushConverter x:Key="StockBrushConverter"/>

        <Style x:Key="MainTabItemStyle" TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="20,10,20,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategoryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CardAltBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CardBrush}" Padding="28,18" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource PrimaryBrush}" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0">
                        <TextBlock Text="₴" Foreground="White" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ProShop POS" Style="{StaticResource PageTitleStyle}" FontSize="18"/>
                        <TextBlock Text="Касовий термінал №1" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,20,0" HorizontalAlignment="Right">
                        <TextBlock Text="П'ятниця, 12 червня 2026" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                        <TextBlock Text="14:32" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Border Background="{StaticResource CardAltBrush}" CornerRadius="20" Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="28" Height="28" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Олена К." VerticalAlignment="Center" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="28,16,28,28" Padding="6">

            <TabControl.Resources>
                <Style TargetType="TabPanel">
                    <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                    <Setter Property="Margin" Value="0"/>
                </Style>
            </TabControl.Resources>

            <TabItem Style="{StaticResource MainTabItemStyle}">
                <TabItem.Header>
                    <TextBlock Text="Каса" Margin="0,0,6,0"/>
                </TabItem.Header>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="Категорії" Style="{StaticResource SectionTitleStyle}"/>
                            <ListBox x:Name="CategoryList" BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     SelectionChanged="CategoryList_SelectionChanged">
                                <ListBoxItem Content="Усі товари" IsSelected="True" Style="{StaticResource CategoryItemStyle}"/>
                                <ListBoxItem Content="Напої" Style="{StaticResource CategoryItemStyle}"/>
                                <ListBoxItem Content="Молочні продукти" Style="{StaticResource CategoryItemStyle}"/>
                                <ListBoxItem Content="Хлібобулочні" Style="{StaticResource CategoryItemStyle}"/>
                                <ListBoxItem Content="Кондитерські" Style="{StaticResource CategoryItemStyle}"/>
                                <ListBoxItem Content="Побутова хімія" Style="{StaticResource CategoryItemStyle}"/>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Column="1" Margin="0,0,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="SearchBox" Grid.Row="0" Style="{StaticResource InputTextBoxStyle}"
                                 TextChanged="SearchBox_TextChanged"
                                 Margin="0,0,0,16" Height="44"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Products}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorderStyle}" Width="200" Margin="0,0,16,16">
                                            <StackPanel>
                                                <Border Height="80" Background="{StaticResource CardAltBrush}" CornerRadius="10" Margin="0,0,0,12">
                                                    <TextBlock Text="{Binding Icon}" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <Border CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,8"
                                                        Background="{Binding Stock, Converter={StaticResource StockBrushConverter}, ConverterParameter=Background}">
                                                    <TextBlock Text="{Binding Stock, StringFormat='Залишок: {0} шт'}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding Stock, Converter={StaticResource StockBrushConverter}, ConverterParameter=Foreground}"/>
                                                </Border>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Price, StringFormat='{}{0:0.00} ₴'}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <Button Grid.Column="1" Content="+" Style="{StaticResource IconButtonStyle}"
                                                            Background="{StaticResource PrimaryBrush}" Foreground="White"
                                                            Tag="{Binding}" Click="AddToCart_Click"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Поточний продаж" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                                <Border Grid.Column="1" Background="{StaticResource CardAltBrush}" CornerRadius="8" Padding="8,4">
                                    <TextBlock Text="{Binding CartItems.Count, StringFormat='{}{0} позицій'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CartItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LineTotal, StringFormat='{}{0:0.00} ₴'}" FontWeight="Bold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>

                                                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,8,0,0">
                                                        <Button Content="−" Style="{StaticResource IconButtonStyle}" Tag="{Binding}" Click="Decrease_Click"/>
                                                        <TextBlock Text="{Binding Quantity}" Width="32" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <Button Content="+" Style="{StaticResource IconButtonStyle}" Tag="{Binding}" Click="Increase_Click"/>
                                                    </StackPanel>
                                                    <Button Grid.Row="1" Grid.Column="1" Content="✕" Style="{StaticResource IconButtonStyle}"
                                                            Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"
                                                            Tag="{Binding}" Click="RemoveItem_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel Grid.Row="2" Margin="0,16,0,0">

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Сума товарів" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat='{}{0:0.00} ₴'}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="До сплати" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat='{}{0:0.00} ₴'}"
                                               FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryLightBrush}"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Отримано від клієнта" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                        <TextBox Style="{StaticResource InputTextBoxStyle}" Height="42"
                                                 Text="{Binding ReceivedInput, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="Решта" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                        <Border Background="{StaticResource CardAltBrush}" CornerRadius="10" Height="42">
                                            <TextBlock Text="{Binding Change, StringFormat='{}{0:0.00} ₴'}" FontWeight="Bold" FontSize="16"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <Button Content="Оформити продаж" Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Stretch" Margin="0,12,0,8" FontSize="16"
                                        Click="Checkout_Click"/>
                                <Button Content="Скасувати" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch"
                                        Click="Cancel_Click"/>
                            </StackPanel>

                        </Grid>
                    </Border>

                </Grid>
            </TabItem>

            <TabItem Style="{StaticResource MainTabItemStyle}">
                <TabItem.Header>
                    <TextBlock Text="Журнал продажів" Margin="0,0,6,0"/>
                </TabItem.Header>
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Журнал продажів" Style="{StaticResource PageTitleStyle}"/>
                            <Border Grid.Column="1" Background="#0F3D30" CornerRadius="8" Padding="12,6">
                                <TextBlock Text="{Binding SalesHistory.Count, StringFormat='Сьогодні продажів: {0}'}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryLightBrush}"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <DatePicker Grid.Column="0" Margin="0,0,12,0" Padding="10" VerticalContentAlignment="Center"/>
                            <DatePicker Grid.Column="1" Margin="0,0,12,0" Padding="10" VerticalContentAlignment="Center"/>
                            <TextBox Grid.Column="2" Style="{StaticResource InputTextBoxStyle}" Height="40" Margin="0,0,12,0"/>
                            <Button Grid.Column="3" Content="Експорт" Style="{StaticResource SecondaryButtonStyle}"/>
                        </Grid>

                        <DataGrid Grid.Row="2" Style="{StaticResource PosDataGridStyle}" AutoGenerateColumns="False"
                                  ItemsSource="{Binding SalesHistory}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="№ ЧЕКА" Width="100" Binding="{Binding Number}"/>
                                <DataGridTextColumn Header="ДАТА ТА ЧАС" Width="160" Binding="{Binding DateTime}"/>
                                <DataGridTextColumn Header="ТОВАРІВ" Width="100" Binding="{Binding ItemsCount}"/>
                                <DataGridTextColumn Header="СУМА" Width="120" Binding="{Binding Total}"/>
                                <DataGridTextColumn Header="ОПЛАЧЕНО" Width="120" Binding="{Binding Paid}"/>
                                <DataGridTextColumn Header="РЕШТА" Width="100" Binding="{Binding Change}"/>
                                <DataGridTextColumn Header="КАСИР" Width="*" Binding="{Binding Cashier}"/>
                                <DataGridTemplateColumn Header="" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Деталі" Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="14,6" FontSize="12"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                    </Grid>
                </Border>
            </TabItem>

        </TabControl>
    </Grid>
</Window>