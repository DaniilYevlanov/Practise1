<Window x:Class="MagazinWPF.Views.CategoryEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Категорія"
        Height="360" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <TextBlock x:Name="HeaderTextBlock" Text="Нова категорія"
                       FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,16"/>

            <TextBlock Text="Назва категорії" FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="NameTextBox" Margin="0,0,0,12"/>

            <TextBlock Text="Опис (необов'язково)" FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="DescriptionTextBox" Margin="0,0,0,12"
                     Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"/>

            <CheckBox x:Name="IsActiveCheckBox" Content="Категорія активна"
                      IsChecked="True" Margin="0,0,0,12"/>

            <TextBlock x:Name="ErrorTextBlock"
                       Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="Collapsed"/>

        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Скасувати" Margin="0,0,6,0"
                    Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
            <Button Grid.Column="1" Content="Зберегти" Margin="6,0,0,0"
                    Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
        </Grid>
    </Grid>
</Window>
