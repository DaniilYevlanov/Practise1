<Window x:Class="MagazinWPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Магазин — Вхід"
        Height="700" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="{StaticResource BackgroundBrush}">

    <Border Background="{StaticResource CardBrush}" CornerRadius="16" Margin="24" Padding="32"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            Effect="{StaticResource CardShadow}">

        <StackPanel>

            <!-- Логотип -->
            <TextBlock Text="🛍" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="Магазин" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,4"/>

            <!-- Вкладки Вхід / Реєстрація -->
            <Grid Margin="0,16,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="TabLoginButton" Grid.Column="0" Content="Вхід"
                        Click="TabLogin_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="TabRegisterButton" Grid.Column="1" Content="Реєстрація"
                        Click="TabRegister_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Setter Property="Background" Value="#F1F3F5"/>
                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- ═══ Панель входу ═══ -->
            <StackPanel x:Name="LoginPanel">

                <TextBlock Text="Логін" FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="LoginTextBox" Margin="0,0,0,12"/>

                <TextBlock Text="Пароль" FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="LoginPasswordBox" Margin="0,0,0,24"/>

                <Button Content="Увійти" Style="{StaticResource PrimaryButton}"
                        Click="LoginButton_Click"/>

            </StackPanel>

            <!-- ═══ Панель реєстрації ═══ -->
            <StackPanel x:Name="RegisterPanel" Visibility="Collapsed">

                <TextBlock Text="Повне ім'я" FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="RegFullNameTextBox" Margin="0,0,0,12"/>

                <TextBlock Text="Логін" FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="RegLoginTextBox" Margin="0,0,0,12"/>

                <TextBlock Text="Пароль" FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="RegPasswordBox" Margin="0,0,0,12"/>

                <TextBlock Text="Підтвердження пароля" FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="RegConfirmPasswordBox" Margin="0,0,0,24"/>

                <Button Content="Зареєструватися" Style="{StaticResource PrimaryButton}"
                        Click="RegisterButton_Click"/>

            </StackPanel>

            <!-- Повідомлення про помилку / успіх -->
            <TextBlock x:Name="MessageTextBlock"
                       Margin="0,14,0,0"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Visibility="Collapsed"/>

        </StackPanel>
    </Border>
</Window>
