<Window x:Class="MagazinWPF.Views.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар"
        Height="620" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock x:Name="HeaderTextBlock" Text="Новий товар"
                           FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,16"/>

                <TextBlock Text="Назва товару" FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="NameTextBox" Margin="0,0,0,12"/>

                <TextBlock Text="Категорія" FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                <ComboBox x:Name="CategoryComboBox" Margin="0,0,0,12"
                          DisplayMemberPath="Name" SelectedValuePath="Id"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Ціна, грн" FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="PriceTextBox"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Залишок, шт" FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="StockTextBox"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Штрих-код (необов'язково)" FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="BarcodeTextBox" Margin="0,0,0,12"/>

                <TextBlock Text="Шлях до зображення (необов'язково)" FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="ImagePathTextBox" Margin="0,0,0,12"/>

                <CheckBox x:Name="IsAvailableCheckBox" Content="Доступний для продажу"
                          IsChecked="True" Margin="0,0,0,8"/>
                <CheckBox x:Name="IsTopCheckBox" Content="Позначити як «Топ»"
                          Margin="0,0,0,8"/>
                <CheckBox x:Name="IsNewCheckBox" Content="Позначити як «Новинка»"
                          Margin="0,0,0,12"/>

                <TextBlock x:Name="ErrorTextBlock"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="Collapsed"/>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Скасувати" Margin="0,0,6,0"
                    Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
            <Button Grid.Column="1" Content="Зберегти" Margin="6,0,0,0"
                    Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
        </Grid>
    </Grid>
</Window>
