<Window x:Class="MagazinWPF.Views.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чек"
        Height="560" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource CardBrush}"
                CornerRadius="14"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Padding="24">
            <StackPanel>

                <!-- Шапка -->
                <TextBlock Text="🛍" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Магазин" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="ФІСКАЛЬНИЙ ЧЕК" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center" Margin="0,2,0,12"/>

                <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,12"/>

                <!-- Мета-дані -->
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="Чек №" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                    <TextBlock x:Name="ReceiptIdTextBlock" HorizontalAlignment="Right"
                               FontSize="12" FontWeight="SemiBold"/>
                </Grid>
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="Дата" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                    <TextBlock x:Name="DateTextBlock" HorizontalAlignment="Right" FontSize="12"/>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="Касир" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                    <TextBlock x:Name="CashierTextBlock" HorizontalAlignment="Right" FontSize="12"/>
                </Grid>

                <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,12"/>

                <!-- Заголовок таблиці -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Товар"    FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock Grid.Column="1" Text="Кіл."     FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Сума, грн" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Right"/>
                </Grid>

                <!-- Позиції чека -->
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                    <ItemsControl x:Name="ItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Product.Name}" FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock FontSize="10" Foreground="{StaticResource MutedTextBrush}">
                                            <Run Text="{Binding UnitPrice, StringFormat=N2}"/>
                                            <Run Text=" грн/шт."/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Quantity}"
                                               FontSize="12" TextAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Subtotal, StringFormat=N2}"
                                               FontSize="12" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,12"/>

                <!-- Підсумки -->
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="Разом" FontSize="13" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="TotalTextBlock" HorizontalAlignment="Right"
                               FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"/>
                </Grid>
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="Сплачено" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="PaidTextBlock" HorizontalAlignment="Right" FontSize="12"/>
                </Grid>
                <Grid>
                    <TextBlock Text="Решта" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="ChangeTextBlock" HorizontalAlignment="Right" FontSize="12"/>
                </Grid>

                <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,16,0,12"/>

                <TextBlock Text="Дякуємо за покупку!" FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center" FontStyle="Italic"/>

            </StackPanel>
        </Border>

        <!-- Кнопки -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Друкувати" Margin="0,0,6,0"
                    Style="{StaticResource SecondaryButton}" Click="Print_Click"/>
            <Button Grid.Column="1" Content="Закрити" Margin="6,0,0,0"
                    Style="{StaticResource PrimaryButton}" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
