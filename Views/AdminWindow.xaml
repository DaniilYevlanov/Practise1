<Window x:Class="MagazinWPF.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Магазин — Панель адміністратора"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="24,16">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🛍" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Магазин" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Панель адміністратора" FontSize="12" Foreground="#D8F3DC"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="UserNameTextBlock" Foreground="White"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="Вийти" Style="{StaticResource SecondaryButton}" Click="LogoutButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="24,16,24,24">

            <TabItem Header="Товари">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="ProductSearchTextBox"
                                 MaxWidth="320" HorizontalAlignment="Left"
                                 Text="Пошук товару..." Foreground="{StaticResource MutedTextBrush}"/>
                        <Button Grid.Column="1" Content="＋ Додати товар"
                                Style="{StaticResource PrimaryButton}" Click="AddProduct_Click"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ProductsItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="220" Style="{StaticResource ItemCardStyle}">
                                        <StackPanel>

                                            <Border Height="110" Background="#F1F3F5" CornerRadius="10" Margin="0,0,0,10">
                                                <TextBlock Text="📦" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                       TextWrapping="Wrap" Margin="0,0,0,4"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Price, StringFormat=N0}"
                                                           Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" FontSize="15"/>
                                                <TextBlock Text=" грн" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" FontSize="15"/>
                                            </StackPanel>

                                            <Border Style="{StaticResource BadgeBorder}" Background="{StaticResource PrimaryLightBrush}" Margin="0,0,0,12">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Залишок: " Style="{StaticResource BadgeText}" Foreground="{StaticResource PrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Stock}" Style="{StaticResource BadgeText}" Foreground="{StaticResource PrimaryBrush}"/>
                                                </StackPanel>
                                            </Border>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="Редагувати" Margin="0,0,4,0"
                                                        Style="{StaticResource SecondaryButton}" Tag="{Binding}" Click="EditProduct_Click"/>
                                                <Button Grid.Column="1" Content="Видалити" Margin="4,0,0,0"
                                                        Style="{StaticResource DangerButton}" Tag="{Binding}" Click="DeleteProduct_Click"/>
                                            </Grid>

                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Категорії">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="＋ Додати категорію" HorizontalAlignment="Right" Margin="0,0,0,12"
                            Style="{StaticResource PrimaryButton}" Click="AddCategory_Click"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="CategoriesItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="260" Style="{StaticResource ItemCardStyle}">
                                        <StackPanel>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>

                                                <Border Grid.Column="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource BadgeBorder}">
                                                            <Setter Property="Background" Value="{StaticResource SuccessLightBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Background" Value="{StaticResource DangerLightBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                                <Setter Property="Text" Value="Активна"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                        <Setter Property="Text" Value="Неактивна"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>

                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" MinHeight="32"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="Редагувати" Margin="0,0,4,0"
                                                        Style="{StaticResource SecondaryButton}" Tag="{Binding}" Click="EditCategory_Click"/>
                                                <Button Grid.Column="1" Content="Видалити" Margin="4,0,0,0"
                                                        Style="{StaticResource DangerButton}" Tag="{Binding}" Click="DeleteCategory_Click"/>
                                            </Grid>

                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Продажі">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="Оновити" HorizontalAlignment="Right" Margin="0,0,0,12"
                            Style="{StaticResource SecondaryButton}" Click="RefreshSales_Click"/>

                    <Border Grid.Row="1" Style="{StaticResource ItemCardStyle}" Margin="0">
                        <DataGrid x:Name="SalesDataGrid" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="52">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                <DataGridTextColumn Header="Дата" Binding="{Binding SaleDate}" Width="160"/>
                                <DataGridTextColumn Header="Сума, грн" Binding="{Binding TotalAmount}" Width="120"/>
                                <DataGridTextColumn Header="Покупець" Binding="{Binding CashierName}" Width="*"/>
                                <DataGridTemplateColumn Header="Чек" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Переглянути чек"
                                                Style="{StaticResource SecondaryButton}"
                                                  Tag="{Binding}"
                                                  Click="ViewReceipt_Click"
                                                  Padding="10,6"
                                                  FontSize="12"
                                              Margin="4"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>